{
  "schemaVersion": 1,
  "id": "ore_yield",
  "version": "${version}",
  "name": "Ore Yield",
  "description": "Ores are earned from breaking stone-like blocks instead of generating as ore blocks.",
  "authors": ["Ore Yield"],
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.oreyield.fabric.OreYieldModFabric"
    ],
    "client": [
      "com.oreyield.fabric.client.DebugOreInfoHandlerFabric"
    ],
    "datagen": [
      "com.oreyield.fabric.datagen.OreScannerProviderFabric"
    ],
    "modmenu": [
      "com.oreyield.fabric.event.ModMenuIntegration"
    ]
  },
  "mixins": [
    "ore_yield.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
